# A remplir dans Vercel > Project > Settings > Environment Variables. Ne JAMAIS commiter ce fichier rempli.

# MailerLite (token API cree dans MailerLite > Integrations > API)
MAILERLITE_TOKEN=
# Un groupe par chemin (ID numerique du groupe)
ML_GROUP_PARENT=
ML_GROUP_ANIMAUX=
ML_GROUP_SANTE=
ML_GROUP_ECOLO=
ML_GROUP_CHARGE=
# Optionnel : un groupe par chemin ET niveau, prioritaire s'il existe (guide different pour le profil Alerte)
# ML_GROUP_PARENT_ALERTE=
# ML_GROUP_PARENT_VIGILANT=
ML_GROUP_DEFAULT=
# 0 si tu n'as pas cree les champs personnalises segment / niveau / score / guide_want dans MailerLite
ML_SEND_FIELDS=1

# Supabase, cote serveur uniquement (Project Settings > API > service_role). Jamais dans le navigateur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cle admin : 32 caracteres minimum, aleatoire (ex. openssl rand -hex 24). Sert a se connecter a admin.html.
ADMIN_SECRET=

# Domaines autorises a appeler /api/subscribe et /api/track, separes par des virgules (recommande)
ALLOWED_ORIGINS=https://ton-funnel.vercel.app
